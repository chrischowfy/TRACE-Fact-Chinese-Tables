{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZHTabfact / TRACE-Fact v1.0 claim record",
  "type": "object",
  "required": [
    "id",
    "claim",
    "label",
    "evidence_package_id",
    "tables",
    "evidence_cells",
    "context_cells",
    "program",
    "table_topology",
    "package_kind",
    "quality_flags",
    "domain",
    "series",
    "topic",
    "license",
    "surface"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "label": {
      "enum": [
        "SUPPORTS",
        "REFUTES",
        "NEI"
      ]
    },
    "evidence_package_id": {
      "type": "string"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "table_id",
          "title",
          "headers",
          "rows",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "table_id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "period": {
            "type": "integer"
          },
          "source": {
            "type": "object",
            "required": [
              "page_title",
              "page_id",
              "revision_id",
              "url",
              "license"
            ],
            "properties": {
              "page_title": {
                "type": "string"
              },
              "resolved_title": {
                "type": "string"
              },
              "page_id": {
                "type": "integer"
              },
              "revision_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "revision_url": {
                "type": "string"
              },
              "table_index": {
                "type": "integer"
              },
              "license": {
                "type": "string"
              },
              "section_column_recovered": {
                "type": "boolean"
              },
              "merged_table_indexes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "derived_from": {
                "type": "string"
              },
              "derivation": {
                "enum": [
                  "category_decomposition",
                  "period_split"
                ]
              },
              "period": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "evidence_cells": {
      "$ref": "#/$defs/cells",
      "description": "cells read by the program (SUPPORTS/REFUTES); empty for NEI"
    },
    "context_cells": {
      "$ref": "#/$defs/cells",
      "description": "NEI only: grounded cells read before the missing binding"
    },
    "program": {
      "type": "object",
      "required": [
        "category",
        "skeleton_id",
        "operators",
        "table_ids",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "description": "reasoning-family group"
        },
        "skeleton_id": {
          "type": "string"
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op"
            ]
          }
        },
        "table_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "type": "object"
        }
      }
    },
    "table_topology": {
      "enum": [
        "single",
        "two_table",
        "three_plus_table"
      ]
    },
    "package_kind": {
      "enum": [
        "single",
        "split_pair",
        "category_decomp",
        "rank_detail",
        "hub_profile",
        "join_filter",
        "period_pair",
        "category_partner"
      ]
    },
    "quality_flags": {
      "type": "object"
    },
    "domain": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "surface": {
      "type": "object",
      "required": [
        "kind",
        "template_claim"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "llm_paraphrase",
            "template",
            "legacy_preserved"
          ]
        },
        "template_claim": {
          "type": "string"
        }
      },
      "description": "llm_paraphrase: historical LLM surface subject to later semantic screening; template: deterministic realization; legacy_preserved: unchanged public-pilot wording with reconstructed program (original generation method not established). template_claim is the original wording for legacy_preserved."
    }
  },
  "$defs": {
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "table_id",
          "row",
          "col",
          "raw_value",
          "normalized_value"
        ],
        "additionalProperties": false,
        "properties": {
          "table_id": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "col": {
            "type": "string"
          },
          "raw_value": {
            "type": "string"
          },
          "normalized_value": {}
        }
      }
    }
  }
}
